// StarMap BA — Prisma schema
// DB connection URL is configured in prisma.config.ts (reads DATABASE_URL from .env)
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// Punto de observación astronómica en la Provincia de Buenos Aires.
/// Datos de contaminación lumínica (bortle/sqm) medidos vía grilla VIIRS;
/// coordenadas ajustadas a la celda oscura accesible, no al centro del pueblo.
model ObservationPoint {
  id Int @id @default(autoincrement())

  // Identidad
  slug    String @unique
  nombre  String
  partido String

  // Geografía
  lat             Float
  lng             Float
  distanciaCabaKm Int
  tipo            PointType

  // Categoría del lugar: escapada de cielo oscuro u observatorio con visitas.
  // Define el color del borde en el mapa y el encuadre de la ficha.
  categoria PointCategory @default(escapada)

  // Calidad de cielo (medida)
  bortle Int // 1 (excelente) – 9 (cielo de gran ciudad)
  sqm    Float // Sky Quality Meter, mag/arcsec². Mayor = más oscuro.

  // Acceso
  accesoTipo   AccessType
  accesoCamino RoadType

  // Contenido
  descripcion String
  notasAcceso String
  referencia  String?

  // Info para visitantes
  mejorEpoca  String?
  dondeDormir String?
  tips        String[] // lista de consejos prácticos
  experiencia String?
  seguridad   String? // nota práctica de seguridad/acceso (no es un rating)
  hospedajes  Json? // lista de {nombre, distancia_km, url} (Google Maps)

  // Reseñas de la comunidad (rating denormalizado para lectura O(1))
  ratingAvg   Float    @default(0)
  ratingCount Int      @default(0)
  reviews     Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bortle])
  @@index([distanciaCabaKm])
}

/// Reseña de un usuario sobre un punto de observación.
model Review {
  id        String   @id @default(cuid())
  pointId   Int
  userId    String
  rating    Int // 1-5 estrellas
  cuerpo    String // comentario
  consejo   String? // tip de experiencia (opcional)
  status    ModerationStatus @default(APPROVED) // moderación
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  point ObservationPoint @relation(fields: [pointId], references: [id], onDelete: Cascade)
  user  User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pointId, userId]) // una reseña por usuario por punto
  @@index([pointId, status, createdAt]) // listado de aprobadas, paginado
}

enum ModerationStatus {
  APPROVED
  PENDING
  REJECTED
}

/// Nivel de experiencia en astronomía del usuario (perfil de comunidad).
enum AstronomyExperience {
  nada
  basico
  intermedio
  avanzado
}

// ── Auth.js (NextAuth v5) — modelos estándar ──────────────────────
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  // Perfil de la comunidad — se completa en el onboarding tras el primer login.
  firstName  String?
  lastName   String?
  nickname   String?
  experience AstronomyExperience?

  accounts      Account[]
  sessions      Session[]
  reviews       Review[]
  createdAt     DateTime  @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

enum PointType {
  sierra
  costa
  reserva
  pampa
  laguna
  urbano
}

/// Categoría: escapada de cielo oscuro vs observatorio urbano con visitas.
enum PointCategory {
  escapada
  observatorio
}

enum AccessType {
  auto
  auto_caminata_corta
  cuatro_x_cuatro
}

enum RoadType {
  asfalto
  ripio
  tierra
}
