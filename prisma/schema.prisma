// StarMap BA — Prisma schema
// DB connection URL is configured in prisma.config.ts (reads DATABASE_URL from .env)
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// Punto de observación astronómica en la Provincia de Buenos Aires.
/// Datos de contaminación lumínica (bortle/sqm) medidos vía grilla VIIRS;
/// coordenadas ajustadas a la celda oscura accesible, no al centro del pueblo.
model ObservationPoint {
  id Int @id @default(autoincrement())

  // Identidad
  slug    String @unique
  nombre  String
  partido String

  // Geografía
  lat             Float
  lng             Float
  distanciaCabaKm Int
  tipo            PointType

  // Calidad de cielo (medida)
  bortle Int // 1 (excelente) – 9 (cielo de gran ciudad)
  sqm    Float // Sky Quality Meter, mag/arcsec². Mayor = más oscuro.

  // Acceso
  accesoTipo   AccessType
  accesoCamino RoadType

  // Contenido
  descripcion String
  notasAcceso String
  referencia  String?

  // Info para visitantes
  mejorEpoca  String?
  dondeDormir String?
  tips        String[] // lista de consejos prácticos
  experiencia String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bortle])
  @@index([distanciaCabaKm])
}

// ── Auth.js (NextAuth v5) — modelos estándar ──────────────────────
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime  @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

enum PointType {
  sierra
  costa
  reserva
  pampa
  laguna
}

enum AccessType {
  auto
  auto_caminata_corta
  cuatro_x_cuatro
}

enum RoadType {
  asfalto
  ripio
  tierra
}
