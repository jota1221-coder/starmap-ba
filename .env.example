# StarMap BA — Variables de entorno
# Copiá este archivo a `.env` y completá los valores reales.
# `.env` está en .gitignore — NUNCA lo commitees.

# Base de datos PostgreSQL (Neon serverless)
# Crear cuenta gratis en https://console.neon.tech, crear proyecto,
# y copiar el connection string aquí.
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require"

# Auth.js — secreto para firmar sesiones (obligatorio)
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="cambiame-por-un-secreto-aleatorio"
AUTH_URL="http://localhost:3000"

# URL pública del sitio (para OG, sitemap, robots). Cambiar al tener dominio.
NEXT_PUBLIC_SITE_URL="https://starmap-ba-12.vercel.app"

# Upstash — rate limiting (OPCIONAL). Sin esto, NO se aplica rate limit
# (dev y entornos sin Upstash funcionan igual). En producción: crear DB Redis
# gratis en https://upstash.com y pegar las dos variables.
# UPSTASH_REDIS_REST_URL="https://xxx.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="xxxx"

# Resend — envío de magic links por email (OPCIONAL en dev).
# Sin esto, en desarrollo el link se imprime en la consola del server.
# En producción: crear cuenta gratis en https://resend.com y poner la API key.
# RESEND_API_KEY="re_xxxxxxxx"
# EMAIL_FROM="StarMap BA <onboarding@resend.dev>"
